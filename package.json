{
  "name": "snowmobile",
  "version": "0.2.0",
  "description": "Hunt real software for parts, recombine them into new tools, and get grilled on the result as a visual tree.",
  "license": "MIT",
  "type": "module",
  "bin": { "snowmobile": "src/cli.ts" },
  "files": ["src", "shared", "client", "page.html", "app.css", "fonts"],
  "scripts": {
    "start": "bun src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "bun run typecheck && bun test --timeout 30000 --preload ./test/capture.ts",
    "replay": "bun scripts/replay.ts"
  },
  "engines": { "bun": ">=1.2" },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
